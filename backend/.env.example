# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/secretsuper?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
# Generate real random values for these in any non-dev environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- OTP ---
OTP_PROVIDER=mock
OTP_TTL_SECONDS=300

APP_NAME=Secretsuper

# --- CORS ---
# Comma-separated list of allowed origins. Mobile apps don't send an Origin
# header so this only matters for browser clients. Leave empty in dev.
CORS_ORIGINS=

# --- Object Storage (S3-compatible) ---
# Option A: Supabase Storage (recommended for MVP — free 1GB, S3-compatible API)
#   1. supabase.com → New project
#   2. Settings → API → S3 Access Keys → Generate new key
#   3. Storage → New bucket (name below), set "Public" ON
#   4. CORS: allowedOrigins ["*"], allowedMethods ["GET","PUT","POST"]
# Option B: Native AWS S3 — leave S3_ENDPOINT blank, set region + bucket + IAM keys
S3_REGION=us-east-1
S3_BUCKET=media
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Toggle the upload route. Set to `true` once S3 creds above are
# configured. While false, POST /media/upload returns 503 with a clear
# "uploads disabled" message so the mobile client can surface a useful
# error rather than a generic network failure.
S3_ENABLED=false

# --- Upload size limits ---
# UPLOAD_MAX_BYTES is the global multer buffer ceiling (must be the
# largest of the per-type limits below). The per-type caps are enforced
# by the upload middleware so a 50 MB image doesn't slip through under
# the video cap.
UPLOAD_MAX_BYTES=52428800
UPLOAD_MAX_IMAGE_BYTES=10485760
UPLOAD_MAX_VIDEO_BYTES=52428800
UPLOAD_MAX_PDF_BYTES=26214400
UPLOAD_MAX_AUDIO_BYTES=26214400
