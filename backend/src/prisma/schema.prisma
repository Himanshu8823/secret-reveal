// Prisma is the only way the backend talks to Postgres (per CLAUDE.md).
// snake_case at the DB level is fine; Prisma maps to camelCase in app code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  phone         String   @unique
  name          String?
  username      String?  @unique
  avatarUrl     String?  @db.VarChar(512)
  bio           String?  @db.VarChar(160)
  // Expo push token (e.g. "ExponentPushToken[...]"). Null until the device
  // registers one; cleared on logout. One token per user — v1 doesn't
  // support multi-device push.
  expoPushToken String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt    @db.Timestamptz(6)

  refreshTokens  RefreshToken[]
  memberships    GroupMember[]
  sentInvites     GroupInvite[] @relation("InviteInviter")
  receivedInvites GroupInvite[] @relation("InviteInvitee")
  authoredPosts  Post[]          @relation("author")
  responses      Response[]
  reactions      Reaction[]
  comments       Comment[]
  media          Media[]
  pollVotes      PollVote[]
  ratings        Rating[]
  notifications  Notification[]
  postLikes      PostLike[]

  @@map("users")
}

model RefreshToken {
  jti        String   @id @db.Uuid
  userId     String   @db.Uuid
  familyId   String   @db.Uuid
  isUsed     Boolean  @default(false)
  isRevoked  Boolean  @default(false)
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  userAgent  String?  @db.VarChar(255)
  ipAddress  String?  @db.VarChar(45)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId, familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Group {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(60)
  // Sorted, comma-joined user ids of every member (including the creator).
  // A group's identity is its member set, not its name: two groups with the
  // same signature resolve to the same row. NULL for legacy rows created
  // before this column landed — those stay queryable by id but won't be
  // matched by findOrCreateGroupByMembers.
  memberSignature String?  @db.VarChar(2000)
  lastActivityAt  DateTime @default(now()) @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt          @db.Timestamptz(6)

  members GroupMember[]
  invites GroupInvite[]
  posts   Post[]

  @@index([lastActivityAt(sort: Desc)])
  // Partial UNIQUE so that multiple legacy rows with NULL stay non-colliding
  // while new rows with the same signature collapse into one. Enforced via
  // the migration's CREATE UNIQUE INDEX ... WHERE "memberSignature" IS NOT NULL
  // because Prisma's @unique treats NULLs as distinct at the DB level.
  @@map("groups")
}

model GroupMember {
  groupId  String   @db.Uuid
  userId   String   @db.Uuid
  joinedAt DateTime @default(now()) @db.Timestamptz(6)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model GroupInvite {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @db.Uuid
  inviterId String   @db.Uuid
  inviteeId String   @db.Uuid
  status    String   @default("pending") @db.VarChar(20) // pending | accepted | rejected
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter User  @relation("InviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User  @relation("InviteInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([groupId, inviteeId])
  @@index([inviteeId, status])
  @@index([groupId])
  @@map("group_invites")
}

model Media {
  id          String   @id @default(uuid()) @db.Uuid
  uploaderId  String   @db.Uuid
  url         String   @db.VarChar(512)
  s3Key       String?  @db.VarChar(512)
  mimeType    String   @db.VarChar(64)
  sizeBytes   BigInt
  width       Int?
  height      Int?
  durationSec Int?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  uploader       User           @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  postMedia      PostMedia[]
  responseMedia  ResponseMedia[]

  @@index([uploaderId, createdAt(sort: Desc)])
  @@map("media")
}

model Post {
  id                  String   @id @default(uuid()) @db.Uuid
  authorId            String   @db.Uuid
  groupId             String   @db.Uuid
  caption             String   @db.VarChar(2000)
  status              String   @default("active") @db.VarChar(20)  // active | revealed | deleted
  allowedInteractions String[] @default([]) // e.g. ["poll","textComment","reaction","rating","like"]
  // Kept nullable for rows written before the scale was fixed at 1-5.
  // New posts never set it; the API reports every post as a 1-5 scale.
  ratingScale         Int?
  // True when the poll accepts several answers from one voter. Null for
  // every non-poll post — the column only has meaning alongside a
  // "poll" entry in allowedInteractions.
  pollMultiSelect     Boolean?
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt          @db.Timestamptz(6)
  deletedAt           DateTime?

  author         User           @relation("author", fields: [authorId], references: [id], onDelete: Cascade)
  group          Group          @relation(fields: [groupId], references: [id], onDelete: Restrict)
  media          PostMedia[]
  discussionMeta DiscussionMeta?
  responses      Response[]
  reactions      Reaction[]
  comments       Comment[]
  pollOptions    PollOption[]
  pollVotes      PollVote[]
  ratings        Rating[]
  postLikes      PostLike[]

  @@index([groupId, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("posts")
}

model DiscussionMeta {
  postId           String   @id @db.Uuid
  timerMinutes     Int
  revealEndsAt     DateTime @db.Timestamptz(6)
  revealedAt       DateTime?
  revealNotifiedAt DateTime?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([revealEndsAt, revealedAt])
  @@map("discussion_meta")
}

model PostMedia {
  postId  String @db.Uuid
  mediaId String @db.Uuid
  order   Int

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([postId, mediaId])
  @@index([mediaId])
  @@map("post_media")
}

model Response {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  authorId  String   @db.Uuid
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt          @db.Timestamptz(6)
  deletedAt DateTime?

  post   Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media  ResponseMedia[]

  @@index([postId, createdAt])
  @@index([authorId, createdAt(sort: Desc)])
  @@map("responses")
}

model ResponseMedia {
  responseId String @db.Uuid
  mediaId    String @db.Uuid
  order      Int

  response Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  media    Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([responseId, mediaId])
  @@index([mediaId])
  @@map("response_media")
}

model Reaction {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  type      String   @default("like") @db.VarChar(20) // single emoji unicode (e.g. "❤️","😂","🔥") — Like has its own PostLike model, this is emoji-only
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([postId])
  @@map("reactions")
}

// Separate from Reaction on purpose — Like and emoji-reaction are
// independent per product decision (a viewer can have both active on the
// same post at once, neither ever overwrites the other).
model PostLike {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([postId])
  @@map("post_likes")
}

/**
 * One selectable answer on a poll post. The post's caption is the poll
 * question — we do not store the question separately.
 *
 * `order` fixes the display sequence so options never shuffle between
 * renders. Options are immutable once the post is created: editing them
 * after votes exist would silently rewrite what people voted for.
 */
model PollOption {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  label     String   @db.VarChar(120)
  order     Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  post  Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@unique([postId, order])
  @@index([postId])
  @@map("poll_options")
}

/**
 * One user's vote for one option.
 *
 * The primary key is (optionId, userId) rather than (postId, userId)
 * because a multi-select poll lets one user hold several rows for the
 * same post. Single-select is enforced in the service (delete the
 * user's other rows for that post inside the vote transaction), not by
 * the schema — the same table has to serve both modes.
 *
 * `postId` is denormalised alongside `optionId` so counting a post's
 * votes and clearing a user's previous answers are single-index reads
 * instead of joins through poll_options.
 */
model PollVote {
  optionId  String   @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  post   Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([optionId, userId])
  @@index([postId])
  @@index([postId, userId])
  @@map("poll_votes")
}

model Rating {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  value     Int // 1..5 when ratingScale=5, 1..10 when ratingScale=10
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([postId])
  @@map("ratings")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String   @db.VarChar(30) // "invite" | "reveal" | "comment" | "response" | "invite_accepted"
  title     String   @db.VarChar(140)
  body      String   @db.VarChar(280)
  postId    String?  @db.Uuid
  groupId   String?  @db.Uuid
  inviteId  String?  @db.Uuid
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt(sort: Desc)])
  @@map("notifications")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  authorId  String   @db.Uuid
  body      String   @db.VarChar(1000)
  // The comment this one replies to, WhatsApp-style. Null for a top-level
  // comment. onDelete: SetNull rather than Cascade — deleting a quoted
  // comment must not take its replies with it; they lose the quote and
  // stay in the thread as ordinary comments.
  replyToId String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt          @db.Timestamptz(6)
  deletedAt DateTime?

  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyTo Comment?  @relation("CommentReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies Comment[] @relation("CommentReply")

  @@index([postId, createdAt])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([replyToId])
  @@map("comments")
}
