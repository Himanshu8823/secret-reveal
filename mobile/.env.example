# EXPO_PUBLIC_* vars are exposed to the app bundle at runtime.
# Point this at your local backend during dev. For Android emulator, use
# 10.0.2.2 to reach the host machine; for iOS simulator, localhost works.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Google Sign-In ---
# Same OAuth client IDs configured on the backend (see backend/.env.example).
# expo-auth-session picks the right one per platform at runtime; the WEB id
# is required in Expo Go / the AuthSession proxy flow, iOS/Android ids are
# used in a standalone/dev-client build.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
